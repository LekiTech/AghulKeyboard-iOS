        }
      }
    },
    "How to install" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to install"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как установить"
          }
        }
      }
    },
    "It is drawn from one book, the Gospel of Luke in Aghul, and two word lists, so it is small and its vocabulary is uneven. Native speakers have not reviewed it yet. The keyboard learns the words you type and suggests them next time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is drawn from one book, the Gospel of Luke in Aghul, and two word lists, so it is small and its vocabulary is uneven. Native speakers have not reviewed it yet. The keyboard learns the words you type and suggests them next time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он собран по одной книге — Евангелию от Луки на агульском языке — и двум словникам, поэтому невелик и неравномерен по лексике. Носители языка его ещё не проверяли. Клавиатура запоминает слова, которые вы набираете, и подсказывает их в следующий раз."
          }
        }
      }
    },
    "Keyboard settings" : {
